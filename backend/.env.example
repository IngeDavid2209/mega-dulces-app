# =============================================================================
# Mega Dulces Backend - Variables de entorno
# =============================================================================
# Copia este archivo como `.env` (NO commitear) y completa los valores reales.
# El archivo `.env` esta en .gitignore.

# --- Base de datos PostgreSQL ---
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_DB?schema=public
# Ejemplos:
#   - Local (docker): postgresql://mega:mega@localhost:5432/mega_dulces?schema=public
#   - Supabase:       postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres?schema=public
#   - Neon:           postgresql://[USER]:[PASS]@[HOST]/[DB]?sslmode=require
#   - Railway:        ver dashboard del proyecto
DATABASE_URL="postgresql://mega:mega@localhost:5432/mega_dulces?schema=public"

# --- Autenticacion JWT ---
# JWT_SECRET debe ser una cadena aleatoria larga (>= 32 chars).
# Generarla con: openssl rand -base64 48
JWT_SECRET="cambiar-esto-en-produccion-por-una-cadena-larga-aleatoria"
JWT_EXPIRES_IN="7d"

# --- Servidor Express ---
PORT=3000
NODE_ENV="development"

# CORS: dominios permitidos (separados por coma) — el front Angular hara fetch a este backend.
# Para desarrollo: el dev server de Angular es http://localhost:4200
# Para produccion: la URL de Vercel donde corre la app de Mega Dulces.
CORS_ORIGINS="http://localhost:4200,https://mega-dulces-app.vercel.app"

# --- Service secret (interno) ---
# Secret compartido entre el backend Node y las funciones serverless de Vercel
# (api/notify-update.js). Permite que esas funciones llamen a /api/internal/*
# sin necesidad de JWT. Generar con: openssl rand -hex 32
SERVICE_SECRET="cambiar-por-cadena-aleatoria-larga"

# --- Firebase Admin SDK ---
# SOLO para el script de migracion (scripts/migrate-firestore.ts).
# Pegar el JSON COMPLETO del service account como una sola linea (escapando comillas)
# o usar GOOGLE_APPLICATION_CREDENTIALS apuntando a un archivo.
# NO commitear este JSON.
FIREBASE_SERVICE_ACCOUNT=""
# O bien:
# GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"
