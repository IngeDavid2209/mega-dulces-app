rules_version = '2';

// ============================================================================
//  Reglas de seguridad de Firestore — Mega Dulces Task (POST-CUTOVER)
//
//  Despues de migrar a backend Node + Postgres (Fase 5), Firestore queda
//  efectivamente APAGADO. Toda la operacion de datos pasa por el backend; las
//  reglas aqui solo permiten read/write si el usuario es admin Y la app esta
//  en modo legacy (`useBackend=false`). En modo backend, ningun cliente
//  deberia tocar Firestore.
//
//  El acceso `if false` rechaza todo. Lo dejamos asi para:
//   - Evitar lecturas residuales que sigan consumiendo cuota.
//   - Forzar a que cualquier llamada quede registrada como error 403 en
//     consola del navegador para detectar componentes pendientes de migrar.
//
//  Plan B (rollback): cambiar TODAS las reglas a `if request.auth != null`
//  TEMPORALMENTE y poner `useBackend=false` en el front. Asi la app vuelve a
//  Firebase de forma instantanea mientras se diagnostica el problema del
//  backend. Restaurar reglas estrictas DESPUES de recuperar.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas legacy preservadas con `false` para que cualquier intento se vea
    // claramente en la consola como denegado. Si se necesita re-abrir
    // temporalmente alguna coleccion (rollback), cambiar `false` por la
    // condicion correspondiente.

    match /indice_login/{id}     { allow read, write: if false; }
    match /usuarios/{id}         { allow read, write: if false; }
    match /users/{id}            { allow read, write: if false; }
    match /checklists/{id}       { allow read, write: if false; }
    match /catalogo_rutinas/{id} { allow read, write: if false; }
    match /asignaciones_rutinas/{id}{ allow read, write: if false; }
    match /moldes_checklists/{id}{ allow read, write: if false; }
    match /areas_operativas/{id} { allow read, write: if false; }
    match /areas/{id}            { allow read, write: if false; }
    match /descansos_semanales/{id}{ allow read, write: if false; }
    match /notificaciones/{id}   { allow read, write: if false; }
    match /tareas_equipo/{id}    { allow read, write: if false; }

    // `usuarios_tokens` queda cerrado en cliente. La function
    // notify-update.js ahora pide los tokens al backend Node, NO a Firestore.
    // (Si en algun momento quieres conservar Firestore como secundario solo
    // para FCM, cambiar esta linea a `allow read: if request.auth != null`).
    match /usuarios_tokens/{id}  { allow read, write: if false; }

    // Catch-all (denegar lo que no este declarado arriba).
    match /{document=**}         { allow read, write: if false; }
  }
}
